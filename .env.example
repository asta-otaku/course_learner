# API origin used by the browser for Socket.IO and, unless API_URL is set,
# by the server-side proxy (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional. Server-only API origin for the /api/proxy route handlers when the
# server should reach the API on a different host than the browser does.
# API_URL=http://api.internal:3001

# Optional. Meta Pixel loads on marketing/auth/pricing routes when this is set.
NEXT_PUBLIC_META_PIXEL_ID=
